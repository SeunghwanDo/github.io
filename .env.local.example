# ============================================
# Supabase Configuration
# ============================================
# Get these values from your Supabase project settings
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Biz360과 동일한 Supabase 프로젝트 사용 (SSO 연동)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Service role key for server-side operations
# Keep this secret! Never expose in client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# SSO Configuration (Cross-Subdomain Auth)
# ============================================
# Set this to share auth cookies between subdomains
# Example: .biz360.kr allows cookies on biz360.kr and skillbridge.biz360.kr
NEXT_PUBLIC_COOKIE_DOMAIN=.biz360.kr

# OAuth callback URL (update for your domain)
NEXT_PUBLIC_SITE_URL=https://skillbridge.biz360.kr

# ============================================
# Biz360 Integration
# ============================================
BIZ360_API_URL=https://www.biz360.kr/api
BIZ360_API_KEY=your-biz360-api-key
BIZ360_WEBHOOK_SECRET=your-webhook-secret
